NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/buypal?retryWrites=true&w=majority
SESSION_TTL_DAYS=7
COOKIE_NAME=buypal_session

# PayPal Sandbox credentials only. Never commit your real .env file.
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD

# Retailer credentials are kept server-side. Add only credentials issued by
# the retailer's official developer or affiliate programme.
AMAZON_CREATORS_API_ACCESS_KEY=
AMAZON_CREATORS_API_SECRET_KEY=
AMAZON_ASSOCIATES_PARTNER_TAG=
FLIPKART_AFFILIATE_TOKEN=
SWIGGY_MCP_ACCESS_TOKEN=
