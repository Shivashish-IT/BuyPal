NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/buypal?retryWrites=true&w=majority
SESSION_TTL_DAYS=7
COOKIE_NAME=buypal_session

# PayPal Sandbox credentials only. Never commit your real .env file.
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
